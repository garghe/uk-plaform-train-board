# Rail Data Marketplace consumer key for the "Live Departure Board" product.
# Leave empty to run with sample data.
RDM_API_KEY=

# Optional: override the endpoint (no trailing slash, station code is appended).
# RDM_DEPARTURES_URL=https://api1.raildata.org.uk/1010-live-departure-board-dep1_2/LDBWS/api/20220120/GetDepBoardWithDetails

# Optional: TfL app key for the Tube (works without one, at a lower request limit).
# TFL_APP_KEY=

# PORT=3000
